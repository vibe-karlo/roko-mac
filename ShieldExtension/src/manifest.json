{
  "manifest_version": 3,
  "name": "roko Shield",
  "description": "roko's blocking for Dia and other Chromium browsers: ads, trackers, pop-ups, and cookie notices answered with reject.",
  "version": "0",
  "minimum_chrome_version": "121",
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["declarativeNetRequest", "scripting", "storage", "webNavigation", "browsingData"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "roko Shield",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/on-16.png", "32": "icons/on-32.png", "48": "icons/on-48.png" }
  },
  "icons": { "16": "icons/on-16.png", "32": "icons/on-32.png", "48": "icons/on-48.png", "128": "icons/on-128.png" }
}
